# Copy to .env and fill in. Never commit .env.

# Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=
# Your Discord user ID (Settings -> Advanced -> Developer Mode, then right-click yourself -> Copy User ID).
# Only this user can use the bot.
OWNER_ID=

# Riot ssid cookie value (just the value, no "ssid="). See README "Getting the ssid cookie".
# This is full account access - treat it like your password.
RIOT_SSID=
# Alternative to RIOT_SSID: the whole auth.riotgames.com cookie header ("ssid=...; clid=...; ...").
# Sending all auth cookies tends to stay valid longer than ssid alone.
# RIOT_COOKIES=

# Optional: force the shard (na, eu, ap, kr). Detected automatically if unset.
# RIOT_SHARD=

# Automatic shop DMs are configured in Discord with /autopost.

# Optional: where state (wishlist, rotated cookies) is stored. Default ./data
# DATA_DIR=./data
